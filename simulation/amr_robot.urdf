<?xml version="1.0"?>

<!--
    INDOOR LOGISTICS AMR
    =====================
    Dimensions and mass derived from "AMR Power, Energy and Runtime
    Validation Report":
        Empty AMR mass   : 60 kg
        Payload          : 20 kg  (added at runtime as a carried load, not
                                   baked into this URDF's base mass)
        Wheel diameter   : 200 mm  (100 mm radius)
        Drive system     : 2 x 24V geared motors (100 RPM, 10 Nm, 8A rated)
        Sensors          : 2x RGB-D/stereo camera (front, left/right pair),
                           1x RGB camera (front, centre, elevated),
                           1x IMU (chassis centre),
                           2x incremental encoder (co-located with drive
                           wheel joints)

    This robot is intentionally larger than the outdoor exploration robot
    used elsewhere, matching a warehouse-class logistics AMR footprint
    (roughly knee-to-waist height, wide enough to carry a tote/shelf
    payload) rather than a small sidewalk rover.
-->

<robot name="indoor_logistics_amr">

    <!-- ================================================== -->
    <!-- BASE / CHASSIS                                     -->
    <!-- ================================================== -->
    <!-- 0.70 m (length) x 0.50 m (width) x 0.30 m (height).
         Houses battery pack, motor drivers and edge computer. -->

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.70 0.50 0.30"/>
            </geometry>
            <material name="chassis_yellow">
                <color rgba="0.95 0.65 0.10 1"/>
            </material>
        </visual>

        <!-- Collision box is 4 cm shorter at the bottom than the visual
             shell: the wheels and casters bottom out at z=-0.15, and a
             chassis collision box reaching the same height made the
             chassis itself drag on the floor (friction fighting every
             drive and turn command). Top surface (deck, z=+0.15) is
             unchanged. -->
        <collision>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <box size="0.70 0.50 0.26"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0"/>
            <!-- Chassis + battery + onboard compute, i.e. empty mass (60 kg)
                 minus the four wheel sub-assemblies below. -->
            <mass value="54.0"/>
            <inertia
                ixx="1.4750"
                ixy="0"
                ixz="0"
                iyy="2.3750"
                iyz="0"
                izz="2.9583"/>
        </inertial>

    </link>


    <!-- ================================================== -->
    <!-- LEFT DRIVE WHEEL                                   -->
    <!-- ================================================== -->
    <!-- 200 mm diameter (100 mm radius), differential-drive,
         mounted at the chassis mid-length. -->

    <link name="left_drive_wheel">

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.10" length="0.06"/>
            </geometry>
            <material name="wheel_black">
                <color rgba="0.05 0.05 0.05 1"/>
            </material>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.10" length="0.06"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.8"/>
            <inertia
                ixx="0.0049"
                ixy="0"
                ixz="0"
                iyy="0.0049"
                iyz="0"
                izz="0.0090"/>
        </inertial>

    </link>

    <joint name="left_drive_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_drive_wheel"/>
        <origin xyz="0.0 0.28 -0.05"/>
        <axis xyz="0 1 0"/>
    </joint>


    <!-- ================================================== -->
    <!-- RIGHT DRIVE WHEEL                                  -->
    <!-- ================================================== -->

    <link name="right_drive_wheel">

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.10" length="0.06"/>
            </geometry>
            <material name="wheel_black"/>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.10" length="0.06"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.8"/>
            <inertia
                ixx="0.0049"
                ixy="0"
                ixz="0"
                iyy="0.0049"
                iyz="0"
                izz="0.0090"/>
        </inertial>

    </link>

    <joint name="right_drive_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_drive_wheel"/>
        <origin xyz="0.0 -0.28 -0.05"/>
        <axis xyz="0 1 0"/>
    </joint>


    <!-- ================================================== -->
    <!-- FRONT CASTER WHEEL                                 -->
    <!-- ================================================== -->
    <!-- Free-spinning support caster, not driven. Modelled as a simple
         sphere so it offers no steering resistance in the differential
         drive kinematics. -->

    <link name="front_caster_wheel">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
            <material name="wheel_black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.00072"
                ixy="0"
                ixz="0"
                iyy="0.00072"
                iyz="0"
                izz="0.00072"/>
        </inertial>

    </link>

    <joint name="front_caster_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_caster_wheel"/>
        <origin xyz="0.30 0.0 -0.09"/>
        <axis xyz="0 1 0"/>
    </joint>


    <!-- ================================================== -->
    <!-- REAR CASTER WHEEL                                  -->
    <!-- ================================================== -->

    <link name="rear_caster_wheel">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
            <material name="wheel_black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.00072"
                ixy="0"
                ixz="0"
                iyy="0.00072"
                iyz="0"
                izz="0.00072"/>
        </inertial>

    </link>

    <joint name="rear_caster_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_caster_wheel"/>
        <origin xyz="-0.30 0.0 -0.09"/>
        <axis xyz="0 1 0"/>
    </joint>


    <!-- ================================================== -->
    <!-- SENSOR MAST                                        -->
    <!-- ================================================== -->
    <!-- Short fixed column that lifts the camera/IMU payload above the
         chassis deck so the stereo pair has an unobstructed forward view
         over racking-aisle shelving at low shelf height. -->

    <link name="sensor_mast">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.18"/>
            </geometry>
            <material name="mast_grey">
                <color rgba="0.25 0.25 0.28 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.18"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.6"/>
            <inertia
                ixx="0.0017"
                ixy="0"
                ixz="0"
                iyy="0.0017"
                iyz="0"
                izz="0.0006"/>
        </inertial>

    </link>

    <joint name="sensor_mast_joint" type="fixed">
        <parent link="base_link"/>
        <child link="sensor_mast"/>
        <origin xyz="0.28 0.0 0.24"/>
    </joint>


    <!-- ================================================== -->
    <!-- LEFT STEREO CAMERA (OAK-D Lite class)              -->
    <!-- ================================================== -->

    <link name="left_stereo_camera_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.03 0.06 0.03"/>
            </geometry>
            <material name="camera_dark">
                <color rgba="0.08 0.08 0.08 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.03 0.06 0.03"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.08"/>
            <inertia
                ixx="0.00003"
                ixy="0"
                ixz="0"
                iyy="0.00002"
                iyz="0"
                izz="0.00003"/>
        </inertial>

    </link>

    <joint name="left_stereo_camera_joint" type="fixed">
        <parent link="sensor_mast"/>
        <child link="left_stereo_camera_link"/>
        <origin xyz="0.03 0.09 0.07"/>
    </joint>


    <!-- ================================================== -->
    <!-- RIGHT STEREO CAMERA (OAK-D Lite class)             -->
    <!-- ================================================== -->

    <link name="right_stereo_camera_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.03 0.06 0.03"/>
            </geometry>
            <material name="camera_dark"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.03 0.06 0.03"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.08"/>
            <inertia
                ixx="0.00003"
                ixy="0"
                ixz="0"
                iyy="0.00002"
                iyz="0"
                izz="0.00003"/>
        </inertial>

    </link>

    <joint name="right_stereo_camera_joint" type="fixed">
        <parent link="sensor_mast"/>
        <child link="right_stereo_camera_link"/>
        <origin xyz="0.03 -0.09 0.07"/>
    </joint>


    <!-- ================================================== -->
    <!-- RGB CAMERA (centre, elevated)                      -->
    <!-- ================================================== -->

    <link name="rgb_camera_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.025 0.04 0.025"/>
            </geometry>
            <material name="camera_dark"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.025 0.04 0.025"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.05"/>
            <inertia
                ixx="0.00001"
                ixy="0"
                ixz="0"
                iyy="0.000009"
                iyz="0"
                izz="0.00001"/>
        </inertial>

    </link>

    <joint name="rgb_camera_joint" type="fixed">
        <parent link="sensor_mast"/>
        <child link="rgb_camera_link"/>
        <origin xyz="0.03 0.0 0.11"/>
    </joint>


    <!-- ================================================== -->
    <!-- IMU (chassis centre, close to robot centroid)      -->
    <!-- ================================================== -->
    <!-- BNO085-class IMU. Mounted at the geometric centre of the chassis
         rather than on the mast so angular-rate/acceleration readings are
         least disturbed by mast flex and lever-arm effects. -->

    <link name="imu_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.01"/>
            </geometry>
            <material name="imu_red">
                <color rgba="0.8 0.1 0.1 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.01"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.01"/>
            <inertia
                ixx="0.0000004"
                ixy="0"
                ixz="0"
                iyy="0.0000004"
                iyz="0"
                izz="0.0000007"/>
        </inertial>

    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.0 0.0 0.05"/>
    </joint>


    <!-- ================================================== -->
    <!-- MAGNET PAD - FRONT (chassis-top docking point)     -->
    <!-- ================================================== -->
    <!-- Chassis-top electromagnet pads. These are the counterparts to
         magnet_pad_front_link / magnet_pad_rear_link on the overhead
         station URDFs (robotic_arm_station.urdf, conveyor_station.urdf).
         Two pads front and rear, rather than one central pad, so a
         docked station is held at two points along the AMR's length and
         cannot rock/topple about a single contact. Mounted on the
         chassis top deck (base_link top face is at local z=+0.15). -->

    <link name="magnet_pad_front_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="magnet_silver">
                <color rgba="0.75 0.75 0.78 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.3"/>
            <inertia
                ixx="0.0002"
                ixy="0"
                ixz="0"
                iyy="0.0002"
                iyz="0"
                izz="0.0004"/>
        </inertial>

    </link>

    <joint name="magnet_pad_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="magnet_pad_front_link"/>
        <!-- 0.25 m forward of chassis centre, same forward offset used
             by the station pads so front-to-front / rear-to-rear
             alignment holds when the AMR is centred under a station. -->
        <origin xyz="0.25 0.0 0.16"/>
    </joint>


    <!-- ================================================== -->
    <!-- MAGNET PAD - REAR (chassis-top docking point)      -->
    <!-- ================================================== -->

    <link name="magnet_pad_rear_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="magnet_silver"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.3"/>
            <inertia
                ixx="0.0002"
                ixy="0"
                ixz="0"
                iyy="0.0002"
                iyz="0"
                izz="0.0004"/>
        </inertial>

    </link>

    <joint name="magnet_pad_rear_joint" type="fixed">
        <parent link="base_link"/>
        <child link="magnet_pad_rear_link"/>
        <origin xyz="-0.25 0.0 0.16"/>
    </joint>


    <!-- ================================================== -->
    <!-- MAGNET PAD - MID (arm-module docking point)        -->
    <!-- ================================================== -->
    <!-- The swappable suction-arm module (suction_arm_module.urdf) sits
         on the rear/centre of the deck, behind the sensor mast, so it
         cannot reach the front pad (which is under the mast). It locks
         on with the rear pad + this mid pad instead - still two points
         along the AMR's length, so the module cannot rock about a
         single contact. Added at the end of the file so existing link
         indices are unchanged. -->

    <link name="magnet_pad_mid_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="magnet_silver"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.3"/>
            <inertia
                ixx="0.0002"
                ixy="0"
                ixz="0"
                iyy="0.0002"
                iyz="0"
                izz="0.0004"/>
        </inertial>

    </link>

    <joint name="magnet_pad_mid_joint" type="fixed">
        <parent link="base_link"/>
        <child link="magnet_pad_mid_link"/>
        <origin xyz="0.05 0.0 0.16"/>
    </joint>

</robot>
