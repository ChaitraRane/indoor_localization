<?xml version="1.0"?>

<!--
    STATIONARY 6-DOF ROBOTIC ARM STATION
    ======================================
    Fixed-base manipulator mounted on a pedestal in the PICKING zone. The
    AMR (amr_robot.urdf) drives underneath the pedestal; when docked, the
    pedestal's electromagnet pads clamp onto the AMR's chassis-top magnet
    pads so the whole station rides steady while the arm works.

    KINEMATIC CHAIN (6 revolute joints, anthropomorphic / UR-style layout)
    ========================================================================
        pedestal_link
            -> shoulder_pan_joint   (revolute, Z)   -> shoulder_link
            -> shoulder_lift_joint  (revolute, Y)   -> upper_arm_link
            -> elbow_joint          (revolute, Y)   -> forearm_link
            -> wrist_1_joint        (revolute, Y)   -> wrist_1_link
            -> wrist_2_joint        (revolute, Z)   -> wrist_2_link
            -> wrist_3_joint        (revolute, X)   -> tool_flange_link

    tool_flange_link is the end-effector frame that inverse-kinematics
    waypoints should target (its origin is the point the gripper/tool
    would be mounted at).

    DUAL-POINT MAGNETIC DOCKING
    ========================================================================
    Two magnet pads (magnet_pad_front_link, magnet_pad_rear_link) hang
    from the underside of the pedestal, spaced along the AMR's length so
    the two attachment points resist the tipping moment the arm's own
    motion creates. They are offset to align directly above the AMR's own
    magnet_pad_front_link / magnet_pad_rear_link (see amr_robot.urdf) when
    the AMR is centred under the pedestal. The actual "electromagnet"
    behaviour (switching the pull on/off) is implemented in Python as a
    PyBullet constraint created/removed between matching pad links - see
    magnetic_docking.py - not inside this URDF.

    Dimensions are sized against amr_robot.urdf (0.70 x 0.50 x 0.30 m
    chassis, deck top at local z=+0.15 relative to base_link origin, i.e.
    world z=~0.30 m when the AMR is standing on its wheels) so the
    pedestal legs straddle the AMR's chassis footprint without the AMR
    touching the arm's structure while docking.
-->

<robot name="robotic_arm_station">

    <!-- ================================================== -->
    <!-- STATION BASE (bolted to the warehouse floor)       -->
    <!-- ================================================== -->

    <link name="station_base_link">

        <visual>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <box size="0.90 0.70 0.04"/>
            </geometry>
            <material name="base_grey">
                <color rgba="0.95 0.60 0.05 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <box size="0.90 0.70 0.04"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.02"/>
            <mass value="40.0"/>
            <inertia
                ixx="1.65"
                ixy="0"
                ixz="0"
                iyy="2.75"
                iyz="0"
                izz="4.08"/>
        </inertial>

    </link>


    <!-- ================================================== -->
    <!-- PEDESTAL (gantry legs + overhead crossbeam)        -->
    <!-- ================================================== -->
    <!-- Two legs straddle the AMR footprint (0.70 x 0.50 m chassis),
         rising to 1.10 m so the AMR (0.30 m tall chassis riding on
         0.10 m wheels, deck top at ~0.30-0.35 m off the floor) can pass
         underneath freely, with the crossbeam carrying the arm base and
         the two magnet pads. -->

    <link name="pedestal_link">

        <!-- Left leg -->
        <visual>
            <origin xyz="0.0 0.32 0.55"/>
            <geometry>
                <box size="0.10 0.10 1.10"/>
            </geometry>
            <material name="pedestal_dark">
                <color rgba="0.95 0.78 0.05 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.32 0.55"/>
            <geometry>
                <box size="0.10 0.10 1.10"/>
            </geometry>
        </collision>

        <!-- Right leg -->
        <visual>
            <origin xyz="0.0 -0.32 0.55"/>
            <geometry>
                <box size="0.10 0.10 1.10"/>
            </geometry>
            <material name="pedestal_dark">
                <color rgba="0.95 0.78 0.05 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 -0.32 0.55"/>
            <geometry>
                <box size="0.10 0.10 1.10"/>
            </geometry>
        </collision>

        <!-- Overhead crossbeam joining the two legs, carries the arm -->
        <visual>
            <origin xyz="0.0 0.0 1.10"/>
            <geometry>
                <box size="0.14 0.74 0.10"/>
            </geometry>
            <material name="pedestal_dark">
                <color rgba="0.95 0.78 0.05 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 1.10"/>
            <geometry>
                <box size="0.14 0.74 0.10"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.6"/>
            <mass value="25.0"/>
            <inertia
                ixx="3.40"
                ixy="0"
                ixz="0"
                iyy="3.10"
                iyz="0"
                izz="1.05"/>
        </inertial>

    </link>

    <joint name="pedestal_joint" type="fixed">
        <parent link="station_base_link"/>
        <child link="pedestal_link"/>
        <origin xyz="0 0 0.04"/>
    </joint>


    <!-- ================================================== -->
    <!-- MAGNET PAD - FRONT (underside of pedestal legs)    -->
    <!-- ================================================== -->
    <!-- Aligned above the AMR's front magnet pad when the AMR is
         centred between the pedestal legs. -->

    <link name="magnet_pad_front_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="magnet_silver">
                <color rgba="0.75 0.75 0.78 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.4"/>
            <inertia
                ixx="0.0003"
                ixy="0"
                ixz="0"
                iyy="0.0003"
                iyz="0"
                izz="0.0005"/>
        </inertial>

    </link>

    <joint name="magnet_pad_front_joint" type="fixed">
        <parent link="pedestal_link"/>
        <child link="magnet_pad_front_link"/>
        <!-- 0.25 m forward of the pedestal centre, just under the
             crossbeam height where the AMR deck would sit while passing
             through; the Python docking logic positions/validates the
             actual contact, this is only the nominal mount point. -->
        <origin xyz="0.25 0.0 0.35"/>
    </joint>


    <!-- ================================================== -->
    <!-- MAGNET PAD - REAR (underside of pedestal legs)     -->
    <!-- ================================================== -->

    <link name="magnet_pad_rear_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="magnet_silver"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.4"/>
            <inertia
                ixx="0.0003"
                ixy="0"
                ixz="0"
                iyy="0.0003"
                iyz="0"
                izz="0.0005"/>
        </inertial>

    </link>

    <joint name="magnet_pad_rear_joint" type="fixed">
        <parent link="pedestal_link"/>
        <child link="magnet_pad_rear_link"/>
        <origin xyz="-0.25 0.0 0.35"/>
    </joint>


    <!-- ================================================== -->
    <!-- JOINT 1 - SHOULDER PAN (yaw about vertical axis)   -->
    <!-- ================================================== -->

    <link name="shoulder_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.07" length="0.12"/>
            </geometry>
            <material name="arm_orange">
                <color rgba="0.90 0.45 0.05 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.07" length="0.12"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="3.5"/>
            <inertia
                ixx="0.010"
                ixy="0"
                ixz="0"
                iyy="0.010"
                iyz="0"
                izz="0.009"/>
        </inertial>

    </link>

    <joint name="shoulder_pan_joint" type="revolute">
        <parent link="pedestal_link"/>
        <child link="shoulder_link"/>
        <!-- Mounted on top of the crossbeam, centred over the AMR
             footprint. -->
        <origin xyz="0.0 0.0 1.16"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="2.0"/>
    </joint>


    <!-- ================================================== -->
    <!-- JOINT 2 - SHOULDER LIFT (pitch, raises the arm)    -->
    <!-- ================================================== -->

    <link name="upper_arm_link">

        <visual>
            <origin xyz="0.20 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.045" length="0.40"/>
            </geometry>
            <material name="arm_orange"/>
        </visual>

        <collision>
            <origin xyz="0.20 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.045" length="0.40"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.20 0 0"/>
            <mass value="4.0"/>
            <inertia
                ixx="0.006"
                ixy="0"
                ixz="0"
                iyy="0.058"
                iyz="0"
                izz="0.058"/>
        </inertial>

    </link>

    <joint name="shoulder_lift_joint" type="revolute">
        <parent link="shoulder_link"/>
        <child link="upper_arm_link"/>
        <origin xyz="0.0 0.0 0.06"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="2.0"/>
    </joint>


    <!-- ================================================== -->
    <!-- JOINT 3 - ELBOW                                    -->
    <!-- ================================================== -->

    <link name="forearm_link">

        <visual>
            <origin xyz="0.18 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.038" length="0.36"/>
            </geometry>
            <material name="arm_orange"/>
        </visual>

        <collision>
            <origin xyz="0.18 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.038" length="0.36"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.18 0 0"/>
            <mass value="2.5"/>
            <inertia
                ixx="0.003"
                ixy="0"
                ixz="0"
                iyy="0.028"
                iyz="0"
                izz="0.028"/>
        </inertial>

    </link>

    <joint name="elbow_joint" type="revolute">
        <parent link="upper_arm_link"/>
        <child link="forearm_link"/>
        <origin xyz="0.40 0.0 0.0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.87979" upper="2.87979" effort="100.0" velocity="2.5"/>
    </joint>


    <!-- ================================================== -->
    <!-- JOINT 4 - WRIST 1                                  -->
    <!-- ================================================== -->

    <link name="wrist_1_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.08"/>
            </geometry>
            <material name="wrist_grey">
                <color rgba="0.55 0.55 0.58 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.08"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>
            <inertia
                ixx="0.0012"
                ixy="0"
                ixz="0"
                iyy="0.0012"
                iyz="0"
                izz="0.0010"/>
        </inertial>

    </link>

    <joint name="wrist_1_joint" type="revolute">
        <parent link="forearm_link"/>
        <child link="wrist_1_link"/>
        <origin xyz="0.36 0.0 0.0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="3.0"/>
    </joint>


    <!-- ================================================== -->
    <!-- JOINT 5 - WRIST 2                                  -->
    <!-- ================================================== -->

    <link name="wrist_2_link">

        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.030" length="0.07"/>
            </geometry>
            <material name="wrist_grey"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.030" length="0.07"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.8"/>
            <inertia
                ixx="0.0008"
                ixy="0"
                ixz="0"
                iyy="0.0008"
                iyz="0"
                izz="0.0007"/>
        </inertial>

    </link>

    <joint name="wrist_2_joint" type="revolute">
        <parent link="wrist_1_link"/>
        <child link="wrist_2_link"/>
        <origin xyz="0.08 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="3.0"/>
    </joint>


    <!-- ================================================== -->
    <!-- JOINT 6 - WRIST 3 (tool roll)                      -->
    <!-- ================================================== -->

    <link name="tool_flange_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.028" length="0.05"/>
            </geometry>
            <material name="flange_black">
                <color rgba="0.08 0.08 0.08 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.028" length="0.05"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.3"/>
            <inertia
                ixx="0.0003"
                ixy="0"
                ixz="0"
                iyy="0.0003"
                iyz="0"
                izz="0.0002"/>
        </inertial>

    </link>

    <joint name="wrist_3_joint" type="revolute">
        <parent link="wrist_2_link"/>
        <child link="tool_flange_link"/>
        <origin xyz="0.07 0.0 0.0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-3.14159" upper="3.14159" effort="28.0" velocity="3.0"/>
    </joint>

</robot>
