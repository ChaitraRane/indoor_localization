<?xml version="1.0"?>

<!--
    SWAPPABLE CONVEYOR MODULE (rides on the AMR deck)
    ==================================================
    Tool module the AMR collects from the conveyor-module stand at the
    RECEPTION dock when the box it found is too big for the suction arm.
    Same mounting as the suction-arm module: the module frame origin is
    the plate underside above the AMR centre, and two electromagnet pads
    (magnet_pad_rear_link / magnet_pad_mid_link) lock onto the AMR's pads.

    PARTS
        module_base_link   0.50 x 0.60 plate, two lift guide columns,
                           hoist lugs (on brackets, outside the belt)
        conveyor_lift_joint  prismatic Z: belt top from module z 0.10
                           (world 0.42) to 0.60 (world 0.92), so the belt
                           can be set level with a shelf or a truck deck
        conveyor_frame_link  side rails + front end stop; frame origin =
                           belt top surface
        belt_link          the belt surface, 0.80 x 0.60, x from -0.62
                           (NOSE, overhanging behind the AMR) to +0.18
                           (front, just behind the sensor mast). Belt
                           motion is applied by the simulator as traction
                           on objects touching this link.
        ir_nose_link / ir_end_link   IR beam sensors across the belt near
                           the nose and near the front end stop
        tof_link           rear-facing time-of-flight range sensor under
                           the nose (measures the gap to a shelf edge)

    Must agree with mission_config.CONV_* constants.
-->

<robot name="conveyor_module">

    <material name="module_grey"><color rgba="0.35 0.37 0.40 1"/></material>
    <material name="frame_blue"><color rgba="0.15 0.35 0.75 1"/></material>
    <material name="belt_black"><color rgba="0.10 0.10 0.11 1"/></material>
    <material name="roller_steel"><color rgba="0.70 0.72 0.75 1"/></material>
    <material name="magnet_silver"><color rgba="0.75 0.75 0.78 1"/></material>
    <material name="ir_red"><color rgba="0.85 0.10 0.10 1"/></material>
    <material name="tof_green"><color rgba="0.10 0.75 0.25 1"/></material>

    <link name="module_base_link">
        <visual>
            <origin xyz="-0.11 0 0.015"/>
            <geometry><box size="0.50 0.60 0.03"/></geometry>
            <material name="module_grey"/>
        </visual>
        <collision>
            <origin xyz="-0.11 0 0.015"/>
            <geometry><box size="0.50 0.60 0.03"/></geometry>
        </collision>
        <!-- lift guide columns -->
        <visual><origin xyz="-0.30 0.40 0.36"/><geometry><box size="0.05 0.03 0.66"/></geometry><material name="frame_blue"/></visual>
        <visual><origin xyz="-0.30 -0.40 0.36"/><geometry><box size="0.05 0.03 0.66"/></geometry><material name="frame_blue"/></visual>
        <visual><origin xyz="0.05 0.40 0.36"/><geometry><box size="0.05 0.03 0.66"/></geometry><material name="frame_blue"/></visual>
        <visual><origin xyz="0.05 -0.40 0.36"/><geometry><box size="0.05 0.03 0.66"/></geometry><material name="frame_blue"/></visual>
        <!-- lift actuator housing -->
        <visual><origin xyz="-0.11 0 0.07"/><geometry><box size="0.20 0.20 0.08"/></geometry><material name="module_grey"/></visual>
        <!-- hoist lugs on brackets (outside the belt, for the stand's rods) -->
        <visual><origin xyz="-0.11 0.355 0.05"/><geometry><box size="0.06 0.06 0.04"/></geometry><material name="magnet_silver"/></visual>
        <visual><origin xyz="-0.11 -0.355 0.05"/><geometry><box size="0.06 0.06 0.04"/></geometry><material name="magnet_silver"/></visual>
        <inertial>
            <origin xyz="-0.11 0 0.05"/>
            <mass value="6.0"/>
            <inertia ixx="0.20" ixy="0" ixz="0" iyy="0.15" iyz="0" izz="0.30"/>
        </inertial>
    </link>

    <link name="magnet_pad_rear_link">
        <visual><geometry><cylinder radius="0.05" length="0.02"/></geometry><material name="magnet_silver"/></visual>
        <inertial><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/></inertial>
    </link>
    <joint name="magnet_pad_rear_joint" type="fixed">
        <parent link="module_base_link"/><child link="magnet_pad_rear_link"/>
        <origin xyz="-0.25 0 -0.01"/>
    </joint>

    <link name="magnet_pad_mid_link">
        <visual><geometry><cylinder radius="0.05" length="0.02"/></geometry><material name="magnet_silver"/></visual>
        <inertial><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/></inertial>
    </link>
    <joint name="magnet_pad_mid_joint" type="fixed">
        <parent link="module_base_link"/><child link="magnet_pad_mid_link"/>
        <origin xyz="0.05 0 -0.01"/>
    </joint>

    <!-- ================================================== -->
    <!-- LIFT (prismatic) + CONVEYOR FRAME                  -->
    <!-- ================================================== -->

    <link name="conveyor_frame_link">
        <!-- side rails -->
        <visual><origin xyz="-0.22 0.315 0.02"/><geometry><box size="0.80 0.02 0.06"/></geometry><material name="frame_blue"/></visual>
        <collision><origin xyz="-0.22 0.315 0.02"/><geometry><box size="0.80 0.02 0.06"/></geometry></collision>
        <visual><origin xyz="-0.22 -0.315 0.02"/><geometry><box size="0.80 0.02 0.06"/></geometry><material name="frame_blue"/></visual>
        <collision><origin xyz="-0.22 -0.315 0.02"/><geometry><box size="0.80 0.02 0.06"/></geometry></collision>
        <!-- front end stop -->
        <visual><origin xyz="0.19 0 0.06"/><geometry><box size="0.02 0.64 0.14"/></geometry><material name="frame_blue"/></visual>
        <collision><origin xyz="0.19 0 0.06"/><geometry><box size="0.02 0.64 0.14"/></geometry></collision>
        <!-- under-frame beam and lift carriage -->
        <visual><origin xyz="-0.22 0 -0.05"/><geometry><box size="0.70 0.10 0.06"/></geometry><material name="module_grey"/></visual>
        <visual><origin xyz="-0.30 0 -0.05"/><geometry><box size="0.06 0.84 0.05"/></geometry><material name="frame_blue"/></visual>
        <visual><origin xyz="0.05 0 -0.05"/><geometry><box size="0.06 0.84 0.05"/></geometry><material name="frame_blue"/></visual>
        <!-- rollers (visual) -->
        <visual><origin xyz="-0.62 0 -0.03" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="0.60"/></geometry><material name="roller_steel"/></visual>
        <visual><origin xyz="0.16 0 -0.03" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="0.60"/></geometry><material name="roller_steel"/></visual>
        <inertial>
            <origin xyz="-0.22 0 0"/>
            <mass value="4.0"/>
            <inertia ixx="0.15" ixy="0" ixz="0" iyy="0.25" iyz="0" izz="0.35"/>
        </inertial>
    </link>
    <joint name="conveyor_lift_joint" type="prismatic">
        <parent link="module_base_link"/>
        <child link="conveyor_frame_link"/>
        <origin xyz="0 0 0.10"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="0.50" effort="1500.0" velocity="0.15"/>
    </joint>

    <link name="belt_link">
        <visual><origin xyz="-0.22 0 -0.01"/><geometry><box size="0.80 0.60 0.02"/></geometry><material name="belt_black"/></visual>
        <collision><origin xyz="-0.22 0 -0.01"/><geometry><box size="0.80 0.60 0.02"/></geometry></collision>
        <inertial><origin xyz="-0.22 0 -0.01"/><mass value="1.0"/>
            <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.08"/></inertial>
    </link>
    <joint name="belt_joint" type="fixed">
        <parent link="conveyor_frame_link"/><child link="belt_link"/>
        <origin xyz="0 0 0"/>
    </joint>

    <!-- IR beam sensors (emitters on the left rail) -->
    <link name="ir_nose_link">
        <visual><geometry><box size="0.02 0.02 0.03"/></geometry><material name="ir_red"/></visual>
        <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    </link>
    <joint name="ir_nose_joint" type="fixed">
        <parent link="conveyor_frame_link"/><child link="ir_nose_link"/>
        <origin xyz="-0.55 0.33 0.04"/>
    </joint>
    <link name="ir_end_link">
        <visual><geometry><box size="0.02 0.02 0.03"/></geometry><material name="ir_red"/></visual>
        <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    </link>
    <joint name="ir_end_joint" type="fixed">
        <parent link="conveyor_frame_link"/><child link="ir_end_link"/>
        <origin xyz="0.12 0.33 0.04"/>
    </joint>

    <!-- rear-facing ToF range sensor under the nose -->
    <link name="tof_link">
        <visual><geometry><box size="0.02 0.05 0.02"/></geometry><material name="tof_green"/></visual>
        <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    </link>
    <joint name="tof_joint" type="fixed">
        <parent link="conveyor_frame_link"/><child link="tof_link"/>
        <origin xyz="-0.62 0 -0.035"/>
    </joint>

</robot>
